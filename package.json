{
  "name": "tamaspalecian",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "dev:website": "turbo dev --filter=@repo/website",
    "dev:studio": "turbo dev --filter=@repo/studio",
    "cms:typegen": "turbo typegen --filter=@repo/cms",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  }
}
